{
  "include": ["app"],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    "venv",
    ".venv"
  ],
  "venvPath": ".",
  "venv": "venv",
  "extraPaths": ["."],
  "typeCheckingMode": "basic",
  "pythonVersion": "3.11",
  "pythonPlatform": "Windows",
  "reportMissingTypeStubs": false,
  "reportMissingModuleSource": "none",
  "reportMissingImports": "none"
}
