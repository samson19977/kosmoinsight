{
  // ── Python interpreter ────────────────────────────────────────────────────
  // Points to the virtual-env created by:  python -m venv venv
  // Adjust the path if your venv is named differently or lives elsewhere.
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",

  // ── Import / type-checking (Pylance / Pyright) ────────────────────────────
  // Treat the workspace root as a source root so  from app.xxx import ...
  // resolves without any "could not be resolved" squiggles.
  "python.analysis.extraPaths": [
    "${workspaceFolder}"
  ],

  // Use the bundled Pylance language server for best results.
  "python.languageServer": "Pylance",

  // Report missing imports as warnings, not errors, while the venv is
  // being set up; flip to "error" once all packages are installed.
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "warning",
    "reportMissingModuleSource": "none"
  },

  // ── Test discovery ────────────────────────────────────────────────────────
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],

  // ── Editor helpers ────────────────────────────────────────────────────────
  "editor.formatOnSave": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  }
}
