# KosmoInsight AI — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env for local development.
# On Render: set these in Dashboard → your service → Environment (NOT .env).
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — Supabase PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@host:5432/postgres?sslmode=require

# REQUIRED — Long random string for JWT signing (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-in-production

# Optional — comma-separated list of extra allowed CORS origins
# localhost:3000 and kosmoinsight.vercel.app are always allowed by default
CORS_ORIGINS=http://localhost:3000,https://your-custom-domain.com

# Optional — set to "development" to enable SQL echo logging
APP_ENV=production

# Optional — rate limit per minute per IP (default: 60)
RATE_LIMIT_PER_MINUTE=60

# Optional — JWT token expiry in minutes (default: 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Mobile Money (optional — simulated if not set) ──────────────────────────
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_ENVIRONMENT=sandbox

AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_ENVIRONMENT=sandbox

# Active payment provider: simulated | mtn_momo | airtel_money
ACTIVE_PROVIDER=simulated

# ─── Notifications (optional — features silently disabled if not set) ─────────
AT_API_KEY=
AT_USERNAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
WHATSAPP_TOKEN=

# ─── Background Workers (optional — Celery/Redis) ────────────────────────────
REDIS_URL=redis://localhost:6379/0
