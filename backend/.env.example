# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth ──────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS (comma-separated) ────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://kosmoinsight.vercel.app

# ── App ───────────────────────────────────────────────────
APP_ENV=production

