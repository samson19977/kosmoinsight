# ============================================================
# Kosmotive Backend – Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================

# Server
NODE_ENV=production
PORT=3000

# PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Auth
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=https://yourfrontend.com

# Email (Resend – https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com
ADMIN_EMAIL=admin@kosmopads.rw

# MTN MoMo Collection API
# Sandbox: https://sandbox.momodeveloper.mtn.com
# Production: https://proxy.momoapi.mtn.com
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_ENVIRONMENT=sandbox
MOMO_SUBSCRIPTION_KEY=your_primary_or_secondary_subscription_key
# API User ID (UUID) created via the MoMo Developer sandbox "create API user" step
MOMO_COLLECTION_USER_ID=your_api_user_id_uuid
# API Key generated for that API User (this is the Basic-auth "password")
MOMO_API_KEY=your_api_key
# Optional: only used for generating manual USSD payment instructions/fallback,
# not required by the Collection API itself
MOMO_MERCHANT_CODE=675566

# Admin seeding (used only by: npm run db:seed)
SEED_ADMIN_NAME=Kosmotive Admin
SEED_ADMIN_EMAIL=admin@kosmopads.rw
SEED_ADMIN_PASSWORD=ChooseAStrongPasswordHere
# Optional — seeds one demo customer + PayGo loan so the dashboard isn't
# empty on first run. Leave unset (or "false") in production.
SEED_DEMO_LOAN=false

# ============================================================
# PayGo installment loan policy (all optional — sensible defaults apply)
# ============================================================
# Days after due_date before a late penalty is charged
LOAN_GRACE_PERIOD_DAYS=3
# One-time late penalty, in basis points of the installment amount (300 = 3%)
LOAN_PENALTY_RATE_BPS=300
# Days before due_date to send the payment reminder email
LOAN_REMINDER_DAYS_BEFORE=3
# Consecutive overdue+unpaid installments before a loan is auto-flagged 'defaulted'
LOAN_DEFAULT_THRESHOLD=3
